# Real pipeline execution E2E (opt-in)
# Copy to apps/web-ui/.env.test.local, edit it, then load it with:
#   set -a
#   source apps/web-ui/.env.test.local
#   set +a

# Disable the local credits gate for this test-created analysis.
BR_CREDITS_ENFORCEMENT=0

# Services used by the Web UI and Playwright configuration.
BR_AGENT_URL=http://localhost:8000
BR_ORCHESTRATOR_URL=http://localhost:3001
BR_KG_URL=http://localhost:5000

# Leave this unset when Playwright should manage a Web UI on port 3002.
# Set it only when an existing local Web UI should be used instead.
# BR_WEB_URL=http://localhost:3000

# Catalog metadata to resolve and the workflow template to execute.
BR_TEST_DATASET_ID=ds:openneuro:ds000001
BR_TEST_TEMPLATE_ID=connectivity/nilearn_connectivity

# Optional template parameters. Quote the entire JSON value and use paths that
# are visible to the executor. This example is intentionally commented out.
# BR_TEST_PARAMS_JSON='{"img":"/app/data/path/to/preprocessed_bold.nii.gz","output_dir":"/app/data/agent_outputs/e2e-real"}'

# Maximum waits in milliseconds. Values below 1000 are interpreted as minutes
# for BR_TEST_MAX_RUN_MS only.
BR_TEST_MAX_RUN_MS=1800000
BR_TEST_ARTIFACT_WAIT_MS=60000

# Generate BR_TEST_TOKEN after loading this file. Do not store it here.
